    reactions: [
        (key: "death:*", headline: "Governor killed: arms makers bid up, the bank sold", moves: [
            (target: "dpac", pct: 0.06), (target: "nrtb", pct: -0.03), (target: "all", pct: -0.01),
        ]),
        (key: "method:loud_kill", headline: "Gunfire around a governor: panic selling, security contracts bid up", moves: [
            (target: "all", pct: -0.02), (target: "dpac", pct: 0.05), (target: "nrtb", pct: -0.02), (target: "avks", pct: 0.11),
        ]),
        (key: "method:quiet_kill", headline: "A governor is found dead: the tape houses say little", moves: [
            (target: "avks", pct: 0.004),
        ]),
        (key: "method:poison", headline: "Poisoning rumour hits tea merchants", moves: [
            (target: "stsc", pct: -0.11), (target: "sector:agri", pct: -0.02),
        ]),
        (key: "method:frame", headline: "The king arrests his own governor: the bank wobbles", moves: [
            (target: "nrtb", pct: -0.06), (target: "aktc", pct: 0.04),
        ]),
        (key: "method:failed", headline: "The governor survives: Avekṣā wins the follow-on contract", moves: [
            (target: "nrtb", pct: 0.01), (target: "avks", pct: 0.09),
        ]),
        (key: "crush", headline: "Deaths in a festival crowd: Avekṣā's safety contract under review, then renewed", moves: [
