        ]),
        (key: "alarm", headline: "Alarm raised at a governor's seat: security stocks firm", moves: [
            (target: "dpac", pct: 0.02), (target: "avks", pct: 0.02), (target: "sector:cement", pct: -0.01),
        ]),
        (key: "removed:*", headline: "A governorate changes hands", moves: [
            (target: "sector:finance", pct: -0.015),
        ]),
    ],
)
