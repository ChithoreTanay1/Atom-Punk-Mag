                balloon: (view_distance: 80.0, view_half_angle_deg: 34.0, rate: 0.7, far_rate: 0.45, decay: 0.3, sweep_deg: 180.0, sweep_speed: 7.0, speed: 0.6),
                drone: (view_distance: 36.0, view_half_angle_deg: 38.0, rate: 1.1, far_rate: 0.4, decay: 0.4, sweep_deg: 20.0, sweep_speed: 30.0, speed: 4.5),
            ),
