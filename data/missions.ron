// Field missions. Locations are ids resolved by the level script
// (godot/scripts/province.gd, temple.gd). All content INVENTED.
[
    (
        id: "saptavarta_night",
        province: "Saptavarta",
        title: "A Thorn in Saptavarta",
        briefing: "The governor of Saptavarta funds the king's river fleet. Remove him tonight, by any means. A quiet death hurts the throne. A death the king orders himself hurts it more.",
        start_minute: 1070.0,
        time_scale: 0.1,
        forgery_requires: "rival_seal",
        depart_intel: "depart_time",
        player_health: 100.0,
        governor_health: 70.0,
        guard_health: 100.0,
        poison_delay: 14.0,
        guards_per_paranoia: 1.0,
        loadout_weapon: "wpn_rifle_ashani",
        loadout_extra: ["wpn_pistol_mriga", "wpn_knife_nakha", "wpn_grapple_garuda"],
        loadout_gadgets: ["gdg_tape_bug", "gdg_static_lure", "gdg_datura_ampoule", "gdg_forged_dispatch"],
        schedule: [
            (at: 1070.0, activity: Work, location: "desk", lines: ["w1", "w2", "w3", "w4"]),
            (at: 1085.0, activity: Meeting, location: "pavilion", lines: ["m1", "m2", "m3", "m4", "m5"]),
            (at: 1100.0, activity: Tea, location: "terrace_tea", lines: ["t1", "t2", "t3"]),
            (at: 1112.0, activity: Inspect, location: "gate_post", lines: ["i1", "i2", "i3"]),
            (at: 1124.0, activity: Work, location: "desk", lines: ["w5", "w6"]),
            (at: 1140.0, activity: Depart, location: "motor_court", lines: ["d1"]),
        ],
        lines: [
            (id: "w1", speaker: "Governor", text: "Telex the river tolls to Pataliputra. Every pana counted twice.", intel: None),
            (id: "w2", speaker: "Governor", text: "No, the courier sees me in the garden pavilion. Not in here, the walls have ears.", intel: Some("meeting_place")),
            (id: "w3", speaker: "Governor", text: "And tea on the terrace at twenty past six. Not a minute later.", intel: Some("tea_habit")),
            (id: "w4", speaker: "Governor", text: "If anything happens, I'm in the strongroom under the east wing. You know the drill.", intel: Some("strongroom")),
            (id: "m1", speaker: "Courier", text: "Governor. The western march sends its regards. Insincere, as always.", intel: None),
            (id: "m2", speaker: "Governor", text: "Mahasena of Vatsabhumi. That snake. He seals his letters with a ram's head, did you know?", intel: Some("rival_seal")),
            (id: "m3", speaker: "Courier", text: "The king's inspectors trust anything that comes over the office telex.", intel: Some("telex_trust")),
            (id: "m4", speaker: "Governor", text: "Then let us keep my telex clean. Go. My car leaves at seven sharp.", intel: Some("depart_time")),
            (id: "m5", speaker: "Courier", text: "And the culvert under the west wall? The masons never sealed it.", intel: Some("culvert")),
            (id: "t1", speaker: "Governor", text: "Ah. The only honest thing in this province is the tea.", intel: None),
            (id: "t2", speaker: "Governor", text: "Leave the trolley. I'll pour it myself.", intel: None),
            (id: "t3", speaker: "Governor", text: "Rakshasa's men count my lamps from the road, you know. Every lamp.", intel: None),
            (id: "i1", speaker: "Governor", text: "Who is on the gate? You. Stand straighter.", intel: None),
            (id: "i2", speaker: "Governor", text: "Double the watch on the east wing after dark.", intel: None),
            (id: "i3", speaker: "Guard", text: "Sir. The service door at the back is still on the old lock.", intel: Some("service_door")),
            (id: "w5", speaker: "Governor", text: "Bring the car round to the motor court. Seven o'clock.", intel: Some("depart_time")),
            (id: "w6", speaker: "Governor", text: "Pack the ledgers. All of them.", intel: None),
            (id: "d1", speaker: "Governor", text: "Drive.", intel: None),
        ],
        intel: [
            (id: "meeting_place", title: "Meeting in the pavilion", text: "He meets a courier in the garden pavilion, around 18:05."),
            (id: "tea_habit", title: "Tea at 18:20", text: "Tea is served on the residence terrace at 18:20. He pours it himself. The trolley waits there beforehand."),
            (id: "strongroom", title: "The strongroom", text: "On an alarm he shelters in a strongroom under the east wing."),
            (id: "rival_seal", title: "The ram's-head seal", text: "His rival Mahasena of Vatsabhumi seals letters with a ram's head. A forged dispatch can now carry that seal."),
            (id: "telex_trust", title: "The office telex", text: "The king's inspectors trust messages sent from the governor's own office telex."),
            (id: "depart_time", title: "Departure at 19:00", text: "His car leaves the motor court at 19:00. After that he is out of reach tonight."),
            (id: "culvert", title: "West wall culvert", text: "An unsealed storm culvert runs under the west wall. Crouch to pass."),
            (id: "service_door", title: "Service door", text: "The service door at the back of the residence is on an old lock."),
        ],
    ),
    // Mission2.md, "Nothing Unobserved". Every name, line, number and rule is
    // INVENTED. Hiranyavaha is a real old name for the Son River [HIST], used
    // here only as a region. Avekṣā's Arthashastra Bk 1 inspiration is DESIGN.
    (
        id: "hiranyavaha_festival",
        province: "Hiranyavaha Circle",
        title: "Nothing Unobserved",
        briefing: "THE KING'S GOLD MOVES THROUGH THE HIRANYAVAHA CIRCLE, AND ITS GOVERNOR COUNTS IT. ON FESTIVAL DAY HE WALKS THE PROCESSIONAL ROUTE TO PRESENT THE KING'S ENDOWMENT, IN FRONT OF THOUSANDS OF PILGRIMS. HE IS EASY TO FIND. THE DIFFICULTY IS THAT EVERYONE ELSE CAN FIND HIM TOO.",
        scene: "res://scenes/temple.tscn",
        start_minute: 985.0,
        time_scale: 0.1,
        forgery_requires: "goad_seal",
        depart_intel: "departure",
        player_health: 100.0,
        governor_health: 70.0,
        guard_health: 100.0,
        poison_delay: 16.0,
        guards_per_paranoia: 1.0,
        loadout_weapon: "wpn_pistol_mriga",
        loadout_extra: ["wpn_rifle_ashani", "wpn_knife_nakha", "wpn_grapple_garuda"],
        loadout_gadgets: ["gdg_tape_bug", "gdg_static_lure", "gdg_datura_ampoule", "gdg_forged_dispatch"],
        gadget_counts: [("gdg_tape_bug", 3), ("gdg_forged_dispatch", 2)],
        exfil_text: "Exfiltrate: take the bike out of the gate and up the A1 to the safehouse yard",
        alarm_text: "ALARM: he is sheltering in the vault behind the reception room",
        dispatches: [
            (method: QuietKill, text: "The governor's accounts balanced the night he did not."),
            (method: LoudKill, text: "Avekṣā Corp has been awarded the Hiranyavaha security contract, renewable annually."),
            (method: Poison, text: "Avekṣā reports no irregularities. It recorded none."),
            (method: Frame, text: "The king acted on information received. The information was on letterhead."),
            (method: Failed, text: "The governor's accounts are in order. Avekṣā has asked for a larger budget."),
        ],
        schedule: [
            (at: 985.0, activity: Work, location: "rec_desk", lines: ["a1", "a2", "a3", "a4"]),
            (at: 993.0, activity: Meeting, location: "rec_sofa", lines: ["b1", "b2", "b3", "b4"]),
            (at: 1001.0, activity: Procession, location: "proc_start", lines: ["p1", "p2", "p3", "p4", "p5"]),
            (at: 1029.0, activity: Inspect, location: "sanctum_rail", lines: ["s1", "s2", "s3"]),
            (at: 1037.0, activity: Tea, location: "rec_tea", lines: ["t1", "t2", "t3"]),
            (at: 1047.0, activity: Work, location: "rec_desk", lines: ["w1", "w2"]),
            (at: 1056.0, activity: Depart, location: "motor_pool", lines: ["d1"]),
        ],
        lines: [
            (id: "a1", speaker: "Governor", text: "Read me the endowment again. In figures. The words are for the priests.", intel: None),
            (id: "a2", speaker: "Governor", text: "I walk at half past four. Down to the forecourt and back up. The king wishes it seen, so let it be seen.", intel: Some("route")),
            (id: "a3", speaker: "Governor", text: "If there is trouble I go to the vault behind this room. Not a step before.", intel: Some("vault")),
            (id: "a4", speaker: "Governor", text: "And nobody touches the tea. I take it here after the presentation, as I always do.", intel: Some("tea")),
            (id: "b1", speaker: "Liaison", text: "Avekṣā's compliments, Governor. Seventeen feeds on the festival, and a tape of every one.", intel: None),
            (id: "b2", speaker: "Governor", text: "Seventeen feeds and one room. What happens when a man in that room goes to pray?", intel: None),
            (id: "b3", speaker: "Liaison", text: "A dark feed is noticed within minutes. A dark zone, sooner. The breakers ring on the desk.", intel: Some("dead_feed")),
            (id: "b4", speaker: "Governor", text: "Kumaradeva of Ujjayanta sent his regards too. He seals everything with an elephant goad, the vain man. Owes me for two hundred war elephants.", intel: Some("goad_seal")),
            (id: "p1", speaker: "Governor", text: "Slower. It is an endowment, not a retreat.", intel: None),
            (id: "p2", speaker: "Liaison", text: "Patrols are thin on the upper terrace, Governor. We have them where the people are.", intel: Some("patrols")),
            (id: "p3", speaker: "Governor", text: "They always part. Nobody has ever needed to tell them.", intel: None),
            (id: "p4", speaker: "Guard", text: "The tape room's order slips come through the telex there. Anyone with a seal can move a patrol.", intel: Some("order_slips")),
            (id: "p5", speaker: "Governor", text: "Count them when we reach the top. All of them. Somebody will ask.", intel: None),
            (id: "s1", speaker: "Governor", text: "On behalf of the throne. Let it be entered.", intel: None),
            (id: "s2", speaker: "Liaison", text: "Entered, and on tape.", intel: None),
            (id: "s3", speaker: "Governor", text: "It would be a poor offering if nobody were watching.", intel: None),
            (id: "t1", speaker: "Governor", text: "Leave it. Reception room, and no one comes in until I have finished.", intel: None),
            (id: "t2", speaker: "Governor", text: "The tea here is the only thing in the Circle I have not had audited.", intel: None),
            (id: "t3", speaker: "Liaison", text: "The inspectors in the capital read that reception telex before their own.", intel: Some("telex_trust")),
            (id: "w1", speaker: "Governor", text: "The car at six, in the motor pool behind the east court. The ledgers go first.", intel: Some("departure")),
            (id: "w2", speaker: "Governor", text: "Tell Avekṣā the festival was quiet. Tell them I want that in writing.", intel: None),
            (id: "d1", speaker: "Governor", text: "Drive.", intel: None),
        ],
        intel: [
            (id: "route", title: "The processional route", text: "At about 16:40 he walks from the reception room, down the grand stair to the forecourt and back up to the sanctum rail. The crowd parts for him."),
            (id: "vault", title: "The vault", text: "On an alarm he shelters in a vault behind the reception room."),
            (id: "tea", title: "Ceremonial tea", text: "After the presentation, about 17:17, he takes tea in the reception room. The service waits on the walnut sideboard."),
            (id: "dead_feed", title: "Dead feeds", text: "The monitoring room notices a looped zone in minutes, a pulled feed sooner, a dark zone sooner still. A destroyed camera is an immediate alert. Reset a zone before its timer runs out."),
            (id: "goad_seal", title: "The elephant-goad seal", text: "Kumaradeva Pingala of Ujjayanta seals letters with an elephant goad, and owes the governor money. A forged dispatch can now carry that seal."),
            (id: "patrols", title: "Thin patrols", text: "Avekṣā keeps its patrols where the crowd is; the upper terrace is lightly walked."),
            (id: "order_slips", title: "Order slips", text: "Patrol orders come through the monitoring room's telex. A Forged Dispatch sent from there clears one sector for a while."),
            (id: "telex_trust", title: "The reception telex", text: "The inspectors in the capital trust messages from the governor's reception telex."),
            (id: "departure", title: "Departure at 17:36", text: "His car leaves the motor pool behind the east court at about 17:36. After that he is out of reach."),
        ],
        festival: Some((
            surveillance: (
                loop_notice_s: 240.0,
                pull_notice_s: 150.0,
                power_notice_s: 75.0,
                jam_notice_s: 45.0,
