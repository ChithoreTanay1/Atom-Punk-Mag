[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
windows.debug.x86_64 = "res://../target/debug/bridge.dll"
windows.release.x86_64 = "res://../target/release/bridge.dll"
linux.debug.x86_64 = "res://../target/debug/libbridge.so"
linux.release.x86_64 = "res://../target/release/libbridge.so"
