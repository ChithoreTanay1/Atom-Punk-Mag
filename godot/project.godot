; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Magadha 326-B"
config/description="Stealth-assassination slice. Simulated Magadha in grey atompunk."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Magadha 326-B"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="vehicle"
3d_physics/layer_5="interact"
3d_physics/layer_6="zone"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.66, 0.69, 0.7, 1)
occlusion_culling/use_occlusion_culling=true

[shader_globals]

weather_wet={
"type": "float",
"value": 0.0
}
weather_snow={
"type": "float",
"value": 0.0
}
weather_rain={
"type": "float",
"value": 0.0
}
